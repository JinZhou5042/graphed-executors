# Coverage for the `test-htcondor` CI job: the main matrix omits `*/htcondor_backend/*`, and this job
# measures it from the m66, m67, m68a, m68b and m68c suites, including the local pilot and driver subprocesses
# (parallel + sigterm, as in `.coveragerc-parsl`). m68a adds the engine's service set, which these
# suites drive through pilots and driver jobs.
[run]
branch = true
parallel = true
sigterm = true
# Directories, not dotted names: coverage resolves a dotted name by importing its parent package and
# then evicting what that import loaded from sys.modules, which broke later pickling (#71). CI sets
# GRAPHED_EXECUTORS_SRC to an absolute path, since pilots and services run in other directories.
source =
    ${GRAPHED_EXECUTORS_SRC-src}/graphed_executors/htcondor_backend
    ${GRAPHED_EXECUTORS_SRC-src}/graphed_executors/submit
omit =
    */graphed_executors/submit/__init__.py
    */graphed_executors/submit/engine.py
    */graphed_executors/submit/protocol.py
    */graphed_executors/submit/recipes.py
    */graphed_executors/submit/threadpool.py

[report]
fail_under = 90
show_missing = true
